# Firebase Console → Project settings → Your apps → Web app.
# These are client configuration values, not Admin SDK secrets.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
EXPO_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client IDs.
# Web is also used to obtain the Firebase credential in native builds.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=

# Backend reachable from your phone (LAN IP during development, HTTPS in production).
EXPO_PUBLIC_API_BASE_URL=
# Enable only together with backend ENABLE_DEMO for explicitly labelled repair demos.
EXPO_PUBLIC_ENABLE_DEMO=false

# Public production support details. Publish a reviewed policy before release.
EXPO_PUBLIC_SUPPORT_EMAIL=
EXPO_PUBLIC_PRIVACY_URL=

# Optional deployed web origin for shareable join links (no trailing slash).
# Without this, native links require the installed Navo app; Expo Go links are development-only.
EXPO_PUBLIC_INVITE_BASE_URL=

# Production public endpoints; secrets belong in your backend/proxy, never these URLs.
# Development uses Photon and FOSSGIS foot routing for light testing when unset.
# Configure dedicated/provider-approved capacity before publishing.
EXPO_PUBLIC_PHOTON_URL=
# OSRM-compatible base serving a WALKING dataset; /route/v1/foot is appended.
EXPO_PUBLIC_WALKING_ROUTER_URL=

# Optional chat-only endpoint while shared Firebase-backed services are unavailable.
# If unset, chat uses EXPO_PUBLIC_API_BASE_URL. Production must use HTTPS.
EXPO_PUBLIC_CHAT_BASE_URL=
