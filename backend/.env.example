# Server only. Run commands from backend/.
FIREBASE_PROJECT_ID=navo-57a5c
# Chat uses this existing public client key, not an Admin credential.
# EXPO_PUBLIC_FIREBASE_API_KEY is also accepted from the backend environment.
FIREBASE_WEB_API_KEY=
# Persistent chat limits; use a durable writable path when hosting.
# CHAT_BUDGET_PATH=/data/chat-budgets.sqlite3
# Prefer approved service-account impersonation ADC for local development.
# With standard ADC, leave all three credential fields below empty.
# GOOGLE_APPLICATION_CREDENTIALS here accepts a service-account JSON path only.
# Inline email/key must be a complete pair and take precedence over the path.
# Backend settings are cached: restart after editing this environment.
GOOGLE_APPLICATION_CREDENTIALS=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
# Match the actual local Expo origin explicitly at startup; never use a wildcard.
CORS_ORIGINS=http://localhost:8081,http://localhost:8099
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.us-central1.nebius.com/v1
# Nemotron model used by Navo chat and itinerary generation.
NEBIUS_MODEL=nvidia/nemotron-3-super-120b-a12b
ENABLE_DEMO=false

# Optional: Expo enhanced push security token, server only.
EXPO_ACCESS_TOKEN=

# AI ceilings: chat uses local SQLite; itinerary generation uses Firestore.
AI_ENABLED=true
AI_DAILY_REQUESTS=100
AI_USER_DAILY_REQUESTS=100
# Random server-only secret (32+ characters), also set as GitHub Actions secret.
# Leave unset to disable scheduled maintenance HTTP access.
MAINTENANCE_TOKEN=

# Journey templates are shared; personal origins never enter this database.
# Use a durable shared path for processes on one host. Separate hosts need shared storage.
# JOURNEY_STORE_PATH=/data/journeys.sqlite3
JOURNEY_DAILY_RESEARCH=20
# Recommended primary web-search provider. Set this in backend/.env for reliable
# structured search results; never expose it in the Expo client environment.
# Without it, Navo tries DuckDuckGo HTML/lite and Wikipedia API fallbacks.
JOURNEY_SEARCH_KEY=

# Passwordless email login. Server only: never use EXPO_PUBLIC_ for these values.
BREVO_API_KEY=
# A sender verified in your Brevo account.
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=Navo
# Generate once with: python -c "import secrets; print(secrets.token_urlsafe(48))"
AUTH_OTP_SECRET=
# Durable storage shared by workers on one host; multi-host deployments need shared DB storage.
# AUTH_OTP_STORE_PATH=/data/email-otp.sqlite3

# Server-side journey fallback when the primary daily allowance or provider quota is reached.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3.5-super-vl:free
OPENROUTER_DAILY_REQUESTS=100
OPENROUTER_USER_DAILY_REQUESTS=100
