# Server only. Run commands from backend/.
FIREBASE_PROJECT_ID=navo-57a5c
# Prefer Application Default Credentials or an untracked service account path.
GOOGLE_APPLICATION_CREDENTIALS=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
CLERK_SECRET_KEY=
CLERK_ISSUER=
# Comma-separated allowed Clerk azp origins. Include the actual native origin if present.
CLERK_AUTHORIZED_PARTIES=http://localhost:8081,http://localhost:8099
CORS_ORIGINS=http://localhost:8081,http://localhost:8099
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1
# Exact Nemotron ID from your Nebius model catalogue; intentionally no invented default.
NEBIUS_MODEL=
ENABLE_DEMO=false
