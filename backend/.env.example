# Server only. Run commands from backend/.
FIREBASE_PROJECT_ID=navo-57a5c
# Prefer approved service-account impersonation ADC for local development.
# With standard ADC, leave all three credential fields below empty.
# GOOGLE_APPLICATION_CREDENTIALS here accepts a service-account JSON path only.
# Inline email/key must be a complete pair and take precedence over the path.
# Backend settings are cached: restart after editing this environment.
GOOGLE_APPLICATION_CREDENTIALS=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
# Match the actual local Expo origin explicitly at startup; never use a wildcard.
CORS_ORIGINS=http://localhost:8081,http://localhost:8099
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.us-central1.nebius.com/v1
# Nemotron model used by Navo chat and itinerary generation.
NEBIUS_MODEL=nvidia/nemotron-3-super-120b-a12b
ENABLE_DEMO=false

# Optional: Expo enhanced push security token, server only.
EXPO_ACCESS_TOKEN=

# Shared AI request ceilings, including chat and itinerary generation.
AI_ENABLED=true
AI_DAILY_REQUESTS=100
AI_USER_DAILY_REQUESTS=10
# Random server-only secret (32+ characters), also set as GitHub Actions secret.
# Leave unset to disable scheduled maintenance HTTP access.
MAINTENANCE_TOKEN=
